rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Used for reads (existing docs) — compares doc's ownerUid to caller.
    function owns(res) {
      return signedIn() && res.ownerUid == request.auth.uid;
    }

    // Used for creates/updates (incoming docs) — checks the payload's ownerUid.
    function willOwn(res) {
      return signedIn() && res.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read:   if owns(resource.data);
      allow create: if willOwn(request.resource.data);
      allow update: if owns(resource.data) && willOwn(request.resource.data);
      allow delete: if owns(resource.data);

      // Subcollection one level deep: customers, products, invoices, expenses
      match /{collection}/{docId} {
        allow read:   if owns(resource.data);
        allow create: if willOwn(request.resource.data);
        allow update: if owns(resource.data) && willOwn(request.resource.data);
        allow delete: if owns(resource.data);

        // Subcollection two levels deep: payments under invoices
        match /{subcollection}/{subdocId} {
          allow read:   if owns(resource.data);
          allow create: if willOwn(request.resource.data);
          allow update: if owns(resource.data) && willOwn(request.resource.data);
          allow delete: if owns(resource.data);
        }
      }
    }

    // Collection-group read rule for payments (kept for future use)
    match /{path=**}/payments/{paymentId} {
      allow read: if owns(resource.data);
    }
  }
}
